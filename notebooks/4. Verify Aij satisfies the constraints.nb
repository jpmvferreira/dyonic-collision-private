91aac686684c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dhds", "=", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{
      RowBox[{
       SuperscriptBox["Rp", "2"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "Rm"}], "+", "Rp", "+", "2"}], ")"}]}], "+", 
      RowBox[{
       SuperscriptBox["Rm", "2"], 
       RowBox[{"(", 
        RowBox[{"Rm", "+", 
         RowBox[{"2", "Rp"}], "+", "2"}], ")"}]}]}], 
     RowBox[{"4", 
      SuperscriptBox["Rm", "3"], 
      SuperscriptBox["Rp", "3"], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"2", "+", "Rm", "+", "Rp"}], ")"}], "2"]}]]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"dhdZ", "=", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Z", "+", "1"}], ")"}], 
       SuperscriptBox["Rp", "2"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "Rm"}], "+", "Rp", "+", "2"}], ")"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Z", "-", "1"}], ")"}], 
       SuperscriptBox["Rm", "2"], 
       RowBox[{"(", 
        RowBox[{"Rm", "+", 
         RowBox[{"2", "Rp"}], "+", "2"}], ")"}]}]}], 
     RowBox[{"2", 
      SuperscriptBox["Rm", "3"], 
      SuperscriptBox["Rp", "3"], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"Rm", "+", "Rp", "+", "2"}], ")"}], "2"]}]]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.996236703092381*^9, 3.996236828423813*^9}, {
