 RowBox[{
  RowBox[{"A\:0305", "=", 
   RowBox[{
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {
        RowBox[{
         FractionBox[
          RowBox[{"4", "cQ"}], 
          SuperscriptBox["z0", "5"]], "x", " ", "y", " ", "dhds"}], 
        RowBox[{
         RowBox[{"-", 
          FractionBox[
