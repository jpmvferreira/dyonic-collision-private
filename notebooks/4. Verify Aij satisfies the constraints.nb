Cell[TextData[{
 "Define ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "-"], TraditionalForm]],ExpressionUUID->
  "a7367b00-517e-4916-9342-04fc641decf0"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "+"], TraditionalForm]],ExpressionUUID->
  "8c09f84b-7219-4e75-8891-7ec385e8f182"]
}], "Text",
