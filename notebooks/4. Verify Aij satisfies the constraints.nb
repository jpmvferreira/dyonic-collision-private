Cell[BoxData[
 RowBox[{
  RowBox[{"S\:0305", "=", 
   RowBox[{
    FractionBox[
     RowBox[{"cQ", " ", "z0"}], 
     RowBox[{"8", "\[Pi]"}]], 
    FractionBox["1", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["x", "2"], "+", 
         SuperscriptBox["y", "2"], "+", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"z", "+", "z0"}], ")"}], "2"]}], ")"}], 
       RowBox[{"3", "/", "2"}]], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["x", "2"], "+", 
         SuperscriptBox["y", "2"], "+", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"z", "-", "z0"}], ")"}], "2"]}], ")"}], 
       RowBox[{"3", "/", "2"}]]}]], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "y"}], ",", "x", ",", "0"}], "}"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.996233931926629*^9, 3.996233945215316*^9}, {
  3.99623439063758*^9, 3.996234435630053*^9}, {3.996234759136198*^9, 
