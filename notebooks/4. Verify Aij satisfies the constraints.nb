Cell["\<\
As for the vector component of the 3+1 decomposition of the energy momentum \
tensor is\
\>", "Text",
 CellChangeTimes->{{3.996233906542142*^9, 3.996233922332768*^9}, {
  3.996234246990211*^9, 
  3.996234247249319*^9}},ExpressionUUID->"c53cec0d-046e-40e1-b31b-\
