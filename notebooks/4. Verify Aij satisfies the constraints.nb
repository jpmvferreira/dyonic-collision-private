Cell[BoxData[{
 RowBox[{
  RowBox[{"P", "=", 
   FractionBox[
    SqrtBox[
     RowBox[{
      SuperscriptBox["x", "2"], "+", 
      SuperscriptBox["y", "2"]}]], "z0"]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Z", "=", 
   FractionBox["z", "z0"]}], ";"}]}], "Input",
 CellChangeTimes->{{3.996236892391636*^9, 3.996236908060462*^9}},
