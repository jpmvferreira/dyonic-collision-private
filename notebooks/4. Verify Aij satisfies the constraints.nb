  3.996236862396927*^9}},ExpressionUUID->"bd72c87a-1147-401a-a63b-\
75bdac0865e2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Rm", "=", 
   SqrtBox[
    RowBox[{
     SuperscriptBox["P", "2"], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"Z", "+", "1"}], ")"}], "2"]}]]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Rp", "=", 
   SqrtBox[
    RowBox[{
     SuperscriptBox["P", "2"], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"Z", "-", "1"}], ")"}], "2"]}]]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9962368639904118`*^9, 3.996236883819006*^9}, {
  3.9987304024534283`*^9, 3.9987304042108583`*^9}},
