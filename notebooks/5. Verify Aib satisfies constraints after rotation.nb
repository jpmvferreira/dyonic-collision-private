Cell[TextData[{
 "Define ",
 Cell[BoxData[
  FormBox["P", TraditionalForm]],ExpressionUUID->
  "eebb9d9d-6be3-4ebf-b485-974ebb6c1371"],
 " and ",
 Cell[BoxData[
  FormBox["Z", TraditionalForm]],ExpressionUUID->
  "be9a8c00-b0ce-4a96-b181-ec16d2982424"]
}], "Text",
 CellChangeTimes->{{3.996236885644285*^9, 
  3.9962368904337587`*^9}},ExpressionUUID->"d63ec5c9-f16a-406b-ab0c-\
fbeb290c2ac0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"P", "=", 
   FractionBox[
    SqrtBox[
     RowBox[{
      SuperscriptBox["z", "2"], "+", 
      SuperscriptBox["y", "2"]}]], "x0"]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Z", "=", 
   FractionBox["x", "x0"]}], ";"}]}], "Input",
 CellChangeTimes->{{3.996236892391636*^9, 3.996236908060462*^9}, {
  3.996297429385171*^9, 3.996297436352618*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"b8e1659a-1025-491c-a87e-f04072ee4f78"],

Cell[TextData[{
 "Define ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "-"], TraditionalForm]],ExpressionUUID->
  "a3e6805e-a5f3-421b-8464-9b17f36412ce"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "+"], TraditionalForm]],ExpressionUUID->
  "7e715390-b130-444e-a85f-4ccedb841f41"]
}], "Text",
 CellChangeTimes->{{3.9962368552252407`*^9, 
  3.996236862396927*^9}},ExpressionUUID->"a0e9d61d-6eab-4808-bf1d-\
4a55221df013"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Rm", "=", 
   SqrtBox[
    RowBox[{
     SuperscriptBox["P", "2"], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"Z", "-", "1"}], ")"}], "2"]}]]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Rp", "=", 
   SqrtBox[
    RowBox[{
     SuperscriptBox["P", "2"], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"Z", "+", "1"}], ")"}], "2"]}]]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9962368639904118`*^9, 3.996236883819006*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"8655cc6b-a037-4327-bbfc-368555d84314"],

Cell[TextData[{
 "Define the derivatives of ",
 Cell[BoxData[
  FormBox["h", TraditionalForm]],ExpressionUUID->
  "9c8c9257-932f-4994-a725-69237b8d0918"]
}], "Text",
 CellChangeTimes->{{3.996236656496532*^9, 
  3.996236664403666*^9}},ExpressionUUID->"a46408fc-c315-4dde-ba06-\
29e65394f76c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dhds", "=", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{
      SuperscriptBox["Rm", "3"], "+", 
      RowBox[{"2", "Rm", " ", 
       SuperscriptBox["Rp", "2"]}], "+", 
      RowBox[{"2", 
       SuperscriptBox["Rm", "2"], 
       RowBox[{"(", 
        RowBox[{"1", "+", "Rp"}], ")"}]}], "+", 
      RowBox[{
       SuperscriptBox["Rp", "2"], 
       RowBox[{"(", 
        RowBox[{"2", "+", "Rp"}], ")"}]}]}], 
     RowBox[{"4", 
      SuperscriptBox["Rm", "3"], 
      SuperscriptBox["Rp", "3"], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"2", "+", "Rm", "+", "Rp"}], ")"}], "2"]}]]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"dhdZ", "=", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{
      RowBox[{"2", "Rm", " ", 
       SuperscriptBox["Rp", "2"], 
       RowBox[{"(", 
        RowBox[{"Z", "-", "1"}], ")"}]}], "+", 
      RowBox[{
       SuperscriptBox["Rp", "2"], 
       RowBox[{"(", 
        RowBox[{"2", "+", "Rp"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"Z", "-", "1"}], ")"}]}], "+", 
      RowBox[{
       SuperscriptBox["Rm", "3"], 
       RowBox[{"(", 
        RowBox[{"Z", "+", "1"}], ")"}]}], "+", 
      RowBox[{"2", 
       SuperscriptBox["Rm", "2"], 
       RowBox[{"(", 
        RowBox[{"Rp", "+", "1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"Z", "+", "1"}], ")"}]}]}], 
     RowBox[{"2", 
      SuperscriptBox["Rm", "3"], 
      SuperscriptBox["Rp", "3"], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"2", "+", "Rm", "+", "Rp"}], ")"}], "2"]}]]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.996236703092381*^9, 3.996236828423813*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"6b674324-2335-45da-a81e-c430efcd537c"],

Cell[TextData[{
 "Define the conformal extrinsic curvature ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["A", "-"], "ij"], TraditionalForm]],ExpressionUUID->
  "eaf85066-3470-4f25-9bae-c606a088705b"]
}], "Text",
 CellChangeTimes->{{3.996236923308063*^9, 
  3.9962369457536373`*^9}},ExpressionUUID->"05f73f1b-3d05-43fd-ae9d-\
468d58f1ff43"],

Cell[BoxData[
 RowBox[{
  RowBox[{"A\:0305", "=", 
   RowBox[{
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {"0", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["cQ", 
           SuperscriptBox["x0", "4"]]}], "z", " ", "dhdZ"}], 
        RowBox[{
         FractionBox["cQ", 
          SuperscriptBox["x0", "4"]], "y", " ", "dhdZ"}]},
       {
        RowBox[{
         RowBox[{"-", 
          FractionBox["cQ", 
           SuperscriptBox["x0", "4"]]}], "z", " ", "dhdZ"}], 
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           RowBox[{"4", "cQ"}], 
           SuperscriptBox["x0", "5"]]}], "z", " ", "y", " ", "dhds"}], 
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           RowBox[{"2", "cQ"}], 
           SuperscriptBox["x0", "5"]]}], 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["z", "2"], "-", 
           SuperscriptBox["y", "2"]}], ")"}], "dhds"}]},
       {
        RowBox[{
         FractionBox["cQ", 
          SuperscriptBox["x0", "4"]], "y", " ", "dhdZ"}], 
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           RowBox[{"2", "cQ"}], 
           SuperscriptBox["x0", "5"]]}], 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["z", "2"], "-", 
           SuperscriptBox["y", "2"]}], ")"}], "dhds"}], 
        RowBox[{
         FractionBox[
          RowBox[{"4", "cQ"}], 
          SuperscriptBox["x0", "5"]], "z", " ", "y", " ", "dhds"}]}
      }], "\[NoBreak]", ")"}], "//", "FullSimplify"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.996230824960367*^9, 3.9962309637564487`*^9}, 
   3.996231003189207*^9, {3.996232512604117*^9, 3.996232514506089*^9}, {
   3.9962369801817083`*^9, 3.9962370830042*^9}, {3.99623721356925*^9, 
   3.9962372366811523`*^9}, {3.996297504316297*^9, 3.996297639660922*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"aaa77e41-5fe2-4c37-a567-bd5c8e0d72e9"],

Cell["\<\
As for the vector component of the 3+1 decomposition of the energy momentum \
tensor is\
\>", "Text",
 CellChangeTimes->{{3.996233906542142*^9, 3.996233922332768*^9}, {
  3.996234246990211*^9, 
  3.996234247249319*^9}},ExpressionUUID->"c27d1cee-2eda-48a7-aa99-\
dcd043c18d7b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"S\:0305", "=", 
   RowBox[{
    FractionBox["cQ", 
     RowBox[{"8", "\[Pi]"}]], "*", 
    FractionBox["x0", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"x", "-", "x0"}], ")"}], "2"], "+", 
         SuperscriptBox["y", "2"], "+", 
         SuperscriptBox["z", "2"]}], ")"}], 
       RowBox[{"3", "/", "2"}]], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"x", "+", "x0"}], ")"}], "2"], "+", 
         SuperscriptBox["y", "2"], "+", 
         SuperscriptBox["z", "2"]}], ")"}], 
       RowBox[{"3", "/", "2"}]]}]], 
    RowBox[{"{", 
     RowBox[{"0", ",", "z", ",", 
      RowBox[{"-", "y"}]}], "}"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.996233931926629*^9, 3.996233945215316*^9}, {
  3.99623439063758*^9, 3.996234435630053*^9}, {3.996234759136198*^9, 
  3.9962347873184137`*^9}, {3.9962348624196787`*^9, 3.996234874939291*^9}, {
  3.996237103176298*^9, 3.9962371488383837`*^9}, {3.9962974560746183`*^9, 
  3.996297481922556*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"fcc19bb2-29ba-481c-a5be-6a920982ad83"],

Cell[TextData[{
 "Now let\[CloseCurlyQuote]s verify the equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      OverscriptBox["D", "-"], "j"], 
     SuperscriptBox[
      OverscriptBox["A", "-"], "ij"]}], "=", 
    RowBox[{"8", "\[Pi]", " ", 
     SuperscriptBox[
      OverscriptBox["S", "-"], "i"]}]}], TraditionalForm]],ExpressionUUID->
  "4d332d6d-8d80-43a2-9076-6df3c061fd44"],
 " for every value of ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],ExpressionUUID->
  "8d93dffc-66ab-4e5d-937d-f1e987bee267"]
}], "Text",
 CellChangeTimes->{{3.996235909881504*^9, 
