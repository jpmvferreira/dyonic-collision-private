Cell["Prettify the output", "Text",
 CellChangeTimes->{{3.982731283769301*^9, 
  3.9827312869141493`*^9}},ExpressionUUID->"d0cae19e-4059-4918-8990-\
52ffee877ea6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Format", "[", "xm", "]"}], 
  ":=", "\"\<\!\(\*SubscriptBox[\(x\), \(-\)]\)\>\""}], "\n", 
 RowBox[{
  RowBox[{"Format", "[", "ym", "]"}], 
  ":=", "\"\<\!\(\*SubscriptBox[\(y\), \(-\)]\)\>\""}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Format", "[", "zm", "]"}], 
   ":=", "\"\<\!\(\*SubscriptBox[\(z\), \(-\)]\)\>\""}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Format", "[", "xp", "]"}], 
  ":=", "\"\<\!\(\*SubscriptBox[\(x\), \(p\)]\)\>\""}], "\n", 
 RowBox[{
  RowBox[{"Format", "[", "yp", "]"}], 
  ":=", "\"\<\!\(\*SubscriptBox[\(y\), \(p\)]\)\>\""}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Format", "[", "zp", "]"}], 
   ":=", "\"\<\!\(\*SubscriptBox[\(z\), \(p\)]\)\>\""}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Format", "[", "Qm", "]"}], 
  ":=", "\"\<\!\(\*SubscriptBox[\(Q\), \(-\)]\)\>\""}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Format", "[", "Qp", "]"}], 
   ":=", "\"\<\!\(\*SubscriptBox[\(Q\), \(+\)]\)\>\""}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Format", "[", "Pm", "]"}], 
  ":=", "\"\<\!\(\*SubscriptBox[\(P\), \(-\)]\)\>\""}], "\n", 
 RowBox[{
  RowBox[{"Format", "[", "Pp", "]"}], 
  ":=", "\"\<\!\(\*SubscriptBox[\(P\), \(+\)]\)\>\""}]}], "Input",
 CellChangeTimes->{{3.9810289136338177`*^9, 3.98102895547998*^9}, {
  3.982731413662016*^9, 3.982731454543913*^9}, {3.982734822657874*^9, 
  3.982734829055963*^9}, {3.982923539207848*^9, 3.9829235572775393`*^9}, {
  3.999002881756772*^9, 3.9990028842785597`*^9}, {3.999003564643016*^9, 
  3.999003621397236*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"ba249ccf-bd73-41ef-9211-f1d7af30694c"],

Cell["Define auxiliary quantities", "Text",
 CellChangeTimes->{{3.982731250996304*^9, 3.982731258748826*^9}, {
  3.982731292502344*^9, 
  3.982731293337728*^9}},ExpressionUUID->"e87c0b5b-119a-419a-a578-\
6d39472b6af4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"r\:20d7m", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "-", "xm"}], ",", 
     RowBox[{"y", "-", "ym"}], ",", 
     RowBox[{"z", "-", "zm"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"r\:20d7p", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x", "-", "xp"}], ",", 
      RowBox[{"y", "-", "yp"}], ",", 
      RowBox[{"z", "-", "zp"}]}], "}"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"rm", "=", 
   SqrtBox[
    RowBox[{"r\:20d7m", ".", "r\:20d7m"}]]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rp", "=", 
    SqrtBox[
     RowBox[{"r\:20d7p", ".", "r\:20d7p"}]]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"d", "=", 
    SqrtBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"r\:20d7p", "-", "r\:20d7m"}], ")"}], ".", 
      RowBox[{"(", 
       RowBox[{"r\:20d7p", "-", "r\:20d7m"}], ")"}]}]]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"cQ", "=", 
   RowBox[{"4", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Pp", " ", "Qm"}], "-", 
      RowBox[{"Pm", " ", "Qp"}]}], ")"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.98273129394736*^9, 3.982731294811899*^9}, {
  3.982731371661633*^9, 3.982731381965967*^9}, {3.982731474460994*^9, 
  3.982731513955497*^9}, {3.9827318099323483`*^9, 3.982731850359188*^9}, {
  3.999002739747139*^9, 3.999002740266885*^9}, {3.999002844242918*^9, 
  3.99900285044821*^9}, {3.999003173068449*^9, 3.99900323217474*^9}, {
  3.999003299364881*^9, 3.999003384065839*^9}, {3.999003599592689*^9, 
  3.9990036004848948`*^9}, {3.999004145434408*^9, 3.999004157821506*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"01f034ed-5828-4ee5-9f41-bb3476c46ade"],

Cell["Define EM field", "Text",
 CellChangeTimes->{{3.999002742340171*^9, 
  3.999002744640192*^9}},ExpressionUUID->"d73a019f-6264-49bf-89a9-\
dd913793af67"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Ei", "=", 
   RowBox[{
    RowBox[{
     FractionBox["Qm", 
      SuperscriptBox["rm", "3"]], "r\:20d7m"}], "+", 
    RowBox[{
     FractionBox["Qp", 
      SuperscriptBox["rp", "3"]], "r\:20d7p"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Bi", "=", 
   RowBox[{
    RowBox[{
     FractionBox["Pm", 
      SuperscriptBox["rm", "3"]], "r\:20d7m"}], "+", 
    RowBox[{
     FractionBox["Pp", 
      SuperscriptBox["rp", "3"]], "r\:20d7p"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.999002805034739*^9, 3.999002863604414*^9}, {
  3.999003358553637*^9, 3.999003414027671*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"5d3a5356-09b8-4cd4-b50c-ef319c439c99"],

Cell["Compute conformal vector component of energy momentum tensor", "Text",
 CellChangeTimes->{{3.983004773666201*^9, 3.9830048016574507`*^9}, {
  3.999002774525198*^9, 
  3.999002788345048*^9}},ExpressionUUID->"58f70f29-cb65-4337-8172-\
c10b2352507c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"S", "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"4", "\[Pi]"}]], 
    RowBox[{"Ei", "\[Cross]", "Bi"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.982733632201469*^9, 3.982733732515788*^9}, 
   3.983004803720995*^9, {3.9990027636941*^9, 3.999002766215188*^9}, {
   3.999002914170051*^9, 3.999002945401824*^9}, {3.999003420724362*^9, 
   3.999003432693961*^9}, {3.999003530312234*^9, 3.99900353668124*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"aa3b63a1-e886-4049-b9df-38210eb2fec9"],

Cell[TextData[{
 "Here\[CloseCurlyQuote]s the solution for ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["V", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8f4c034a-1bb9-4182-a1cb-67d6aeab9824"]
}], "Text",
 CellChangeTimes->{{3.999003109954315*^9, 3.9990031151188803`*^9}, {
  3.999003258370088*^9, 
  3.999003259064844*^9}},ExpressionUUID->"51f03b03-fc6e-4d87-962a-\
7194e1a436e2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"V", "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["cQ", 
      RowBox[{"2", "d"}]]}], 
    FractionBox[
     RowBox[{"r\:20d7m", "\[Cross]", "r\:20d7p"}], 
     RowBox[{"rm", " ", "rp", 
      RowBox[{"(", 
       RowBox[{"rm", "+", "rp", "+", "d"}], ")"}]}]]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.999003117445237*^9, 3.999003117737843*^9}, {
  3.999003243838039*^9, 3.999003282957117*^9}, {3.999003480099567*^9, 
  3.9990035011355457`*^9}, {3.999004126397684*^9, 3.999004128173745*^9}, {
  3.9990041627627907`*^9, 3.999004163651353*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"cb6dac7f-2521-4e59-a685-dbaacffa2278"],

Cell["See if solution holds", "Text",
 CellChangeTimes->{{3.9990029655826187`*^9, 
  3.99900296831959*^9}},ExpressionUUID->"0f0028e1-beb4-41a4-99f0-\
cba4a8314652"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    SubsuperscriptBox["\[Del]", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y", ",", "z"}], "}"}], "2"], "V"}], "+", 
   RowBox[{
    FractionBox["1", "3"], 
    RowBox[{
     SubscriptBox["\[Del]", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}]], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[Del]", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}]], ".", "V"}], ")"}]}]}], "-", 
   RowBox[{"8", "\[Pi]", " ", "S"}]}], "//", "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.999002993764236*^9, 3.999003015688294*^9}, {
  3.9990030642872477`*^9, 3.999003106807761*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"eca35908-9e8f-4232-851a-3b4321d4a7dd"],

