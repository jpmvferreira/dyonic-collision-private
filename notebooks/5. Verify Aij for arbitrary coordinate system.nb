Cell["The conformal extrinsic curvature can be written as", "Text",
 CellChangeTimes->{{3.9990039487849073`*^9, 3.999003991640842*^9}, {
   3.999004092890758*^9, 3.999004104623536*^9}, 
   3.999004526211488*^9},ExpressionUUID->"365e2d47-5220-4625-a66f-\
aac9f4911ff2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"W", "=", 
   RowBox[{
    FractionBox["cQ", "2"], 
    FractionBox[
     RowBox[{
      RowBox[{
       SuperscriptBox["rp", "2"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "rm"}], "+", "rp", "+", "d"}], ")"}], "r\:20d7m"}], "+", 
      RowBox[{
       SuperscriptBox["rm", "2"], 
       RowBox[{"(", 
        RowBox[{"rm", "+", 
         RowBox[{"2", "rp"}], "+", "d"}], ")"}], "r\:20d7p"}]}], 
     RowBox[{
      SuperscriptBox["rm", "3"], 
      SuperscriptBox["rp", "3"], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"rm", "+", "rp", "+", "d"}], ")"}], "2"]}]]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"m", "=", 
   FractionBox[
    RowBox[{"r\:20d7m", "\[Cross]", "r\:20d7p"}], "d"]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9990041054106216`*^9, 3.999004106179335*^9}, {
  3.999004181837922*^9, 3.9990043548293533`*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"318e8d71-a98e-4b6b-ad63-2f215bc777b8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{
    RowBox[{"Table", "[", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"W", "[", 
         RowBox[{"[", "i", "]"}], "]"}], " ", 
        RowBox[{"m", "[", 
         RowBox[{"[", "j", "]"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"W", "[", 
         RowBox[{"[", "j", "]"}], "]"}], " ", 
        RowBox[{"m", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}]}], ",", " ", "\n", "\t", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "3"}], "}"}], ",", "\n", "\t", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", "3"}], "}"}]}], "\n", "]"}], "//", 
    "FullSimplify"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.999004358554412*^9, 3.999004370708167*^9}, 
   3.999004612201705*^9},
 CellLabel->"In[49]:=",ExpressionUUID->"68af761e-1bc5-492e-a2e0-6efef6945aee"],

Cell[TextData[{
 "Now let\[CloseCurlyQuote]s verify the equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      OverscriptBox["D", "-"], "j"], 
     SubscriptBox[
      OverscriptBox["A", "-"], "ij"]}], "=", 
    RowBox[{"8", "\[Pi]", " ", 
     SubscriptBox[
      OverscriptBox["S", "-"], "i"]}]}], TraditionalForm]],ExpressionUUID->
  "85305f23-1423-4686-ac8f-17bb1c92d0ee"],
