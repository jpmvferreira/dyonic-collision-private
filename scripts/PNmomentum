#!/usr/bin/env python3

# TODO:
# - allow for arbitrary mass ratios (nrpypn assumes mass ratio < 1)
# - use parameters {k,t₋,t₊,α₋}

# imports
from nrpypn.eval_p_t_and_p_r import eval__P_t__and__P_r as evalPtPr
from string import Template
from math import sqrt
import numpy as np
import argparse
import os

def main():
    # parse arguments
    parser = argparse.ArgumentParser(description="Computes linear momentum for the merger of dyonic black holes")

    parser.add_argument("-d",   "--distance",           required=True, type=float, help="Distance from puncture to origin")
    parser.add_argument("-m",   "--mass_ratio",         required=True, type=float, help="Mass ratio")
    parser.add_argument("-tp",  "--charge_ratio_plus",  required=True, type=float, help="Charge to mass ratio of the 'plus' BH")
    parser.add_argument("-tm",  "--charge_ratio_minus", required=True, type=float, help="Charge to mass ratio of the 'minus' BH")

    args = parser.parse_args()

    distance           = 2*args.distance  # nrpypn uses distance between punctures instead of distance to origin
    mass_ratio         = args.mass_ratio
    charge_ratio_plus  = args.charge_ratio_plus
    charge_ratio_minus = args.charge_ratio_minus

    # nrpypn assumes that the mass ratio is larger than one for its computations
    if mass_ratio < 1:
        mass_ratio = 1/mass_ratio

    m_plus     = mass_ratio / (1 + mass_ratio)
    m_minus    = 1 / (1 + mass_ratio)
    total_mass = m_minus + m_plus

    print(f"m_plus  = {m_plus}")
    print(f"m_minus = {m_minus}")
    print()

    # total electric and magnetic charges
    t_plus  = charge_ratio_plus  * m_plus
    t_minus = charge_ratio_minus * m_minus

    print(f"t_plus  = {t_plus}")
    print(f"t_minus = {t_minus}")
    print()

    # compute linear momentum for a quasi-circular inspiral with zero spin
    Pt, Pr = evalPtPr(mass_ratio, distance, 0, 0, 0, 0, 0, 0)

    factor = sqrt(1 - charge_ratio_plus * charge_ratio_minus)  # correction due to charges
    Pt = Pt * total_mass * factor
    Pr = Pr * total_mass * factor

    print(f"Pr = {Pr}")
    print(f"Pt = {Pt}")
    print()

    # compute size of AH
    rah_plus  = np.sqrt(m_plus**2  - t_plus**2)  / 2
    rah_minus = np.sqrt(m_minus**2 - t_minus**2) / 2

    print(f"rah_plus  = {rah_plus}")
    print(f"rah_minus = {rah_minus}")


if __name__ == "__main__":
    main()
